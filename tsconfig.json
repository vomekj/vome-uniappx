{
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "jsx": "preserve",
    "strict": true,
    "target": "ESNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./*"],
      "vome-core/client": ["./node_modules/vome-core/dist/client/index.d.ts"],
      "vome-core/typings/*": ["./node_modules/vome-core/typings/admin/*"]
    },
    "lib": ["ESNext", "DOM"],
    "types": ["@dcloudio/types", "bun"]
  },
  "include": [
    "./**/*.ts",
    "./**/*.d.ts",
    "./**/*.vue",
    "./typings/**/*.d.ts"
  ],
  "exclude": ["node_modules", "unpackage"]
}
